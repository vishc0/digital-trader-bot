# Environment Variables Template
# Copy this file to .env and fill in your values

# ===========================
# Application Settings
# ===========================
APP_NAME=TradeSense AI
APP_ENV=development  # development, staging, production
DEBUG=true
API_VERSION=v1
SECRET_KEY=your-secret-key-here-change-in-production

# ===========================
# Server Configuration
# ===========================
HOST=0.0.0.0
PORT=8000
WORKERS=4
RELOAD=true

# ===========================
# Database
# ===========================
DATABASE_URL=postgresql://user:password@localhost:5432/tradesense_ai
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=300

# ===========================
# Market Data APIs
# ===========================
# Polygon.io
POLYGON_API_KEY=your-polygon-api-key

# IEX Cloud
IEX_CLOUD_API_KEY=your-iex-api-key
IEX_CLOUD_ENV=sandbox  # sandbox or production

# Alpha Vantage
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key

# Finnhub
FINNHUB_API_KEY=your-finnhub-key

# Yahoo Finance (yfinance) - no key needed for dev

# ===========================
# Broker APIs
# ===========================
# Alpaca (for MVP)
ALPACA_API_KEY=your-alpaca-key
ALPACA_SECRET_KEY=your-alpaca-secret
ALPACA_BASE_URL=https://paper-api.alpaca.markets  # paper trading for dev

# Fidelity (Phase 2)
FIDELITY_CLIENT_ID=your-fidelity-client-id
FIDELITY_CLIENT_SECRET=your-fidelity-secret

# TD Ameritrade (Phase 2)
TD_AMERITRADE_CLIENT_ID=your-td-client-id
TD_AMERITRADE_REDIRECT_URI=http://localhost:8000/callback

# ===========================
# News & Sentiment APIs
# ===========================
# NewsAPI.org
NEWS_API_KEY=your-newsapi-key

# Reddit API
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-secret
REDDIT_USER_AGENT=TradeSenseAI/1.0

# Twitter API v2
TWITTER_BEARER_TOKEN=your-twitter-bearer-token

# ===========================
# AI/ML Model Settings
# ===========================
# OpenAI (for AI Coach in Phase 3)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4

# Hugging Face (for FinBERT)
HUGGINGFACE_API_KEY=your-huggingface-key

# Model paths
LSTM_MODEL_PATH=ml_models/lstm_price_predictor.pth
SENTIMENT_MODEL_PATH=ml_models/finbert_sentiment
OPPORTUNITY_MODEL_PATH=ml_models/xgboost_opportunity.pkl
EXIT_STRATEGY_MODEL_PATH=ml_models/dqn_exit_strategy.pth

# ===========================
# Security & Authentication
# ===========================
JWT_SECRET_KEY=your-jwt-secret-key-change-this
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption
ENCRYPTION_KEY=your-encryption-key-32-chars-long

# ===========================
# Monitoring & Logging
# ===========================
# Sentry (error tracking)
SENTRY_DSN=your-sentry-dsn

# Log level
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# ===========================
# Email (for notifications)
# ===========================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@tradesenseai.com

# ===========================
# Celery (Background Tasks)
# ===========================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ===========================
# CORS
# ===========================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,https://tradesenseai.com
ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
ALLOWED_HEADERS=*

# ===========================
# Rate Limiting
# ===========================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ===========================
# Feature Flags
# ===========================
ENABLE_PAPER_TRADING=true
ENABLE_AI_COACH=false  # Phase 3
ENABLE_SOCIAL_FEATURES=false  # Phase 3
